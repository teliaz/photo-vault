# Copy to backup.env and replace every example path/UUID before running.
IMMICH_COMPOSE_DIR=/srv/immich
IMMICH_UPLOAD_DIR=/srv/immich/library
USB_MOUNT=/mnt/photo-backup
USB_UUID=replace-with-filesystem-uuid

# Defaults for the official Immich Compose file; edit if your file differs.
APP_SERVICE=immich-server
DB_SERVICE=database
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
